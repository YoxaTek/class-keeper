# Copy this to .env.local for local development (gitignored). Never point
# any environment's DATABASE_URL at another environment's database, even
# temporarily — each is a fully isolated Neon branch:
#
#   Environment          File            Vercel env    Neon branch
#   ------------------   -------------   -----------   -----------
#   Local dev            .env.local      (n/a)         dev
#   Preview (PRs/branches, incl. staging)  (n/a, set in Vercel dashboard)  Preview     staging
#   Production (main)    (n/a, set in Vercel dashboard)                    Production  main
#
# Migrations: run `npm run db:migrate:dev` locally only (can prompt/reset).
# Vercel's build step runs `npm run vercel-build`, which uses
# `prisma migrate deploy` — applies existing migrations, never generates new
# ones. See vercel.json.

DATABASE_URL="postgresql://app:app@localhost:5435/class_keeper"

# openssl rand -base64 32 — use a DIFFERENT secret per environment.
AUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# Stripe (see https://dashboard.stripe.com/apikeys). Use TEST mode keys for
# dev/staging and LIVE mode keys only for the Production Vercel environment.
STRIPE_SECRET_KEY="sk_test_replace-me"
# From the webhook endpoint's settings page (see README/runbook for setup).
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
# Price IDs for the PRO / INSTITUTION recurring prices you create in Stripe.
STRIPE_PRICE_PRO="price_replace-me"
STRIPE_PRICE_INSTITUTION="price_replace-me"

# Optional extra safety net for prisma/seed.ts's production guard — set this
# to a distinguishing substring of your Neon *production* branch's hostname
# once you know it (e.g. its Neon branch id), only in the Production Vercel
# environment. NODE_ENV/VERCEL_ENV are checked first and already cover most
# cases; this is a belt-and-suspenders fallback.
# PRODUCTION_DB_HOST_MARKER="ep-your-prod-branch-id"
