# Copy this to .env.local for local development (gitignored). Never point
# any environment's DATABASE_URL at another environment's database, even
# temporarily — each is a fully isolated Neon branch:
#
#   Environment          File            Vercel env    Neon branch
#   ------------------   -------------   -----------   -----------
#   Local dev            .env.local      (n/a)         dev
#   Preview (PRs/branches, incl. staging)  (n/a, set in Vercel dashboard)  Preview     staging
#   Production (main)    (n/a, set in Vercel dashboard)                    Production  main
#
# Migrations: run `npm run db:migrate:dev` locally only (can prompt/reset).
# Vercel's build step runs `npm run vercel-build`, which uses
# `prisma migrate deploy` — applies existing migrations, never generates new
# ones. See vercel.json.

DATABASE_URL="postgresql://app:app@localhost:5435/class_keeper"

# openssl rand -base64 32 — use a DIFFERENT secret per environment.
AUTH_SECRET="replace-me"
# No NEXTAUTH_URL / AUTH_URL: either unconditionally overrides the request's
# real host (see next-auth/lib/env.js reqWithEnvURL), which breaks OAuth
# callbacks on every origin but the one hardcoded here — local LAN testing,
# every Vercel Preview URL, everything. auth.ts sets trustHost instead, so
# the real Host header is used.

# Stripe (see https://dashboard.stripe.com/apikeys). Use TEST mode keys for
# dev/staging and LIVE mode keys only for the Production Vercel environment.
STRIPE_SECRET_KEY="sk_test_replace-me"
# From the webhook endpoint's settings page (see README/runbook for setup).
STRIPE_WEBHOOK_SECRET="whsec_replace-me"
# Price IDs for the PRO / INSTITUTION recurring prices you create in Stripe.
STRIPE_PRICE_PRO="price_replace-me"
STRIPE_PRICE_INSTITUTION="price_replace-me"

# Google OAuth (see https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <your-origin>/api/auth/callback/google
# All three login providers are optional and independent — only set up the
# ones you actually want to offer. The login/signup pages only show a
# provider's button once its env vars are present (see src/lib/auth.ts).
GOOGLE_CLIENT_ID="replace-me"
GOOGLE_CLIENT_SECRET="replace-me"

# Facebook Login (free, see https://developers.facebook.com/apps).
# Authorized redirect URI: <your-origin>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID="replace-me"
FACEBOOK_CLIENT_SECRET="replace-me"

# LINE Login (free, see https://developers.line.biz/console).
# Callback URL: <your-origin>/api/auth/callback/line
# Note: LINE only returns the user's email once you separately apply for and
# are granted "Email address permission" for the channel (OpenID Connect ->
# Email address permission in the LINE Developers console) — until then,
# sign-in still works, accounts just get a synthetic placeholder email.
LINE_CLIENT_ID="replace-me"
LINE_CLIENT_SECRET="replace-me"
