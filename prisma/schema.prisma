generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  TEACHER
  TA
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  EXCUSED // 請假 — pre-approved leave
  ABSENT // unexcused
  NOT_ENROLLED // hadn't joined the term yet on this date
}

enum ScoreCategory {
  QUIZ
  ASSIGNMENT
  MIDTERM_READING
  MIDTERM_LISTENING
  FINAL // dedicated final-exam score; ignored when Term.finalExamSessionId overrides it
}

enum PlanTier {
  FREE
  PRO
  INSTITUTION
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

// --- NextAuth (Auth.js) models ---
// Session strategy is JWT (see src/lib/auth.ts), so NextAuth's own
// "Session" table is never used — the Session model below is the
// domain concept (one class meeting), not an auth session.

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id            String          @id @default(cuid())
  email         String          @unique
  name          String?
  role          Role            @default(TEACHER) // the Google sign-up flow creates users via the adapter with no role of its own — a fresh signup with no invite is always a teacher; TA/student roles only ever come from an accepted Invite
  locale        String? // "en-US" | "zh-TW" | "id-ID" | "tl-PH" | "vi-VN", user's preferred UI language
  passwordHash  String? // for Credentials login
  emailVerified DateTime? // for magic-link / adapter compatibility
  image         String?
  accounts      Account[]
  student       Student? // if role = STUDENT, link to their profile
  termsTaught   Term[]          @relation("TeacherTerms")
  taAssignments TermAssistant[]

  // Set once /onboarding is completed (role/org/student-link finalized).
  // Gates access to the rest of the app — see src/lib/termAccess.ts-style
  // check in (app)/layout.tsx.
  onboardingComplete Boolean @default(false)

  // Billing: a teacher's plan comes from their own Subscription, or — if
  // they belong to an Organization — from that org's shared Subscription.
  // Always resolve through getEffectiveSubscription(), never read these
  // fields directly.
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  subscription   Subscription?

  invitesSent    Invite[] @relation("InvitesSent")
  inviteAccepted Invite?  @relation("InviteAccepted")
}

model Organization {
  id           String        @id @default(cuid())
  name         String
  members      User[]
  subscription Subscription?
  invites      Invite[]
}

/**
 * The only way a TA or student role — or membership in an existing
 * Organization — is ever granted. A teacher generates one of these (a
 * shareable link, not an emailed invite — there's no email infra), the
 * recipient signs in with Google, and /onboarding applies it to their
 * account exactly once.
 */
model Invite {
  id    String  @id @default(cuid())
  token String  @unique @default(cuid())
  role  Role
  email String? // if set, only this exact email may accept

  // Exactly one of these is set, matching `role`:
  //   TEACHER -> organizationId (join this org)
  //   TA      -> termId (assigned to this term on acceptance), org optional
  //   STUDENT -> studentId (the existing roster row this account claims)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  termId         String?
  term           Term?         @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentId      String?       @unique
  student        Student?      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  invitedById String
  invitedBy   User   @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  expiresAt        DateTime?
  acceptedAt       DateTime?
  acceptedByUserId String?   @unique
  acceptedByUser   User?     @relation("InviteAccepted", fields: [acceptedByUserId], references: [id])

  createdAt DateTime @default(now())
}

model Subscription {
  id                   String             @id @default(cuid())
  tier                 PlanTier
  status               SubscriptionStatus
  // PayPal has no merchant-created "customer" object like Stripe's — a
  // subscription only gets an identity once the payer approves it, so this
  // is the sole provider identifier we track.
  paypalSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  userId               String?            @unique
  user                 User?              @relation(fields: [userId], references: [id])
  organizationId       String?            @unique
  organization         Organization?      @relation(fields: [organizationId], references: [id])
  // Exactly one of userId / organizationId must be set — enforced in
  // application logic (see src/lib/subscriptions/gate.ts), not the schema.
}

model Subject {
  id    String @id @default(cuid())
  name  String // e.g. "Chinese — Basic", "Chinese — Intermediate"
  terms Term[]
}

model Term {
  id                 String   @id @default(cuid())
  name               String // e.g. "114-2"
  subjectId          String
  subject            Subject  @relation(fields: [subjectId], references: [id])
  teacherId          String
  teacher            User     @relation("TeacherTerms", fields: [teacherId], references: [id])
  startDate          DateTime
  endDate            DateTime
  maxExcusedAbsences Int      @default(3) // beyond this, EXCUSED counts as ABSENT
  passingScore       Float    @default(70) // grade threshold for the below-passing report
  weightAttendance   Float    @default(15)
  weightAssignment   Float    @default(15)
  weightQuiz         Float    @default(30)
  weightMidterm      Float    @default(15)
  weightFinal        Float    @default(15)
  weightImpression   Float    @default(10)
  finalExamSessionId String? // optional override: which session's score counts as the final exam
  institute          String? // shown on the public join page; one value for the whole term, not per student

  assistants  TermAssistant[]
  enrollments Enrollment[]
  sessions    Session[]
  invites     Invite[]
}

model TermAssistant {
  id     String @id @default(cuid())
  termId String
  term   Term   @relation(fields: [termId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([termId, userId])
}

model Student {
  id          String       @id @default(cuid())
  name        String
  studentId   String? // the institution's own student ID — informational, not used as a lookup key
  email       String?
  userId      String?      @unique
  user        User?        @relation(fields: [userId], references: [id])
  enrollments Enrollment[]
  invite      Invite?
}

model Enrollment {
  id        String   @id @default(cuid())
  termId    String
  term      Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  studentId String
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  joinedAt  DateTime @default(now()) // sessions before this date are NOT_ENROLLED for this student

  attendance      Attendance[]
  scores          ScoreRecord[]
  evaluation      Evaluation?
  feedback        Feedback?
  sessionFeedback SessionFeedback[]
  // Max 30 enrollments per term is enforced by a DB trigger, see migration
  // 20260101000000_enrollment_cap_trigger — Prisma's schema DSL has no way
  // to express a per-group row-count constraint directly.

  @@unique([termId, studentId])
}

model Session {
  id                 String   @id @default(cuid())
  termId             String
  term               Term     @relation(fields: [termId], references: [id], onDelete: Cascade)
  date               DateTime
  label              String? // e.g. "L1 生詞"
  hasAttendance      Boolean  @default(false)
  hasQuiz            Boolean  @default(false)
  quizMaxScore       Int      @default(100) // the quiz's total possible points — same for every student in this class
  hasAssignment      Boolean  @default(false)
  assignmentMaxScore Int      @default(100)
  hasMidterm         Boolean  @default(false)
  midtermMaxScore    Int      @default(100) // combined reading + listening total for this class's midterm
  hasFinal           Boolean  @default(false) // marks the session as the final-exam session (ScoreCategory.FINAL); irrelevant when Term.finalExamSessionId is set
  finalMaxScore      Int      @default(100)
  hasFeedback        Boolean  @default(false) // a free-text note per student for this class meeting — not graded, doesn't affect the term grade

  attendance Attendance[]
  scores     ScoreRecord[]
  feedback   SessionFeedback[]
}

model Attendance {
  id           String           @id @default(cuid())
  sessionId    String
  session      Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment       @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  status       AttendanceStatus

  @@unique([sessionId, enrollmentId])
}

// A teacher's free-text note for one student at one class meeting — distinct
// from Feedback, which is a student's own one-time comment for the whole
// term.
model SessionFeedback {
  id           String     @id @default(cuid())
  sessionId    String
  session      Session    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  note         String

  @@unique([sessionId, enrollmentId])
}

model ScoreRecord {
  id             String        @id @default(cuid())
  sessionId      String
  session        Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  enrollmentId   String
  enrollment     Enrollment    @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  category       ScoreCategory
  originalScore  Float? // null = missed / not yet entered
  retakeScore    Float? // 補考 — if present, use this instead of originalScore
  retakeMaxScore Float? // the retake's own total possible points — can differ per student, unlike the main quiz's total
  note           String?

  @@unique([sessionId, enrollmentId, category])
}

model Evaluation {
  id              String     @id @default(cuid())
  enrollmentId    String     @unique
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  narrative       String? // teacher's written evaluation, shown as-written, never auto-translated
  impressionScore Float? // out of the term's weightImpression (default 10)
}

model Feedback {
  id           String     @id @default(cuid())
  enrollmentId String     @unique // unique enforces one feedback per student per term
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  comment      String
  submittedAt  DateTime   @default(now())
}
